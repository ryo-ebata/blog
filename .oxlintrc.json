{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "pedantic": "warn",
    "perf": "warn",
    "style": "warn",
    "restriction": "off",
    "nursery": "off"
  },
  "plugins": ["react", "typescript", "jsx-a11y", "nextjs"],
  "rules": {
    "no-console": "warn",
    "react/react-in-jsx-scope": "off",
    "nextjs/no-html-link-for-pages": "off"
  },
  "overrides": [
    {
      "files": ["components/blog/post-content.tsx", "app/layout.tsx"],
      "rules": {
        "react/no-danger": "off"
      }
    },
    {
      "files": ["**/*.test.tsx", "**/*.test.ts"],
      "rules": {
        "nextjs/no-img-element": "off"
      }
    }
  ],
  "ignorePatterns": ["node_modules", ".next", "out", "storybook-static", "coverage"]
}
